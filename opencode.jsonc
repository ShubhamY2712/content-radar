{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browser1": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--storage-state",
        "auth.json"
      ],
      "enabled": true
    },
