{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "recommendations",
 "type": "object",
 "properties": {
  "recommendations": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "object",
    "properties": {
     "idea": {
      "type": "string"
     },
     "audience": {
      "type": "string"
     },
     "format_platform": {
      "type": "string"
     },
     "hook": {
      "type": "string"
     },
     "message_proof": {
      "type": "string"
     },
     "offer_cta": {
      "type": "string"
     },
     "style_layers": {
      "type": "string"
     },
     "parameters": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[BS][0-9]{2}$"
      }
     },
     "based_on": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "idea",
     "audience",
     "format_platform",
     "hook",
     "message_proof",
     "offer_cta",
     "style_layers",
     "parameters",
     "based_on"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "recommendations"
 ],
 "additionalProperties": false
}