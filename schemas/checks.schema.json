{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "checks",
 "type": "object",
 "properties": {
  "creative_id": {
   "type": "string"
  },
  "answers": {
   "type": "object",
   "description": "The checker's own reading, made without opening the analysis",
   "patternProperties": {
    "^[BS][0-9]{2}$": {
     "type": "object",
     "properties": {
      "option": {
       "type": [
        "string",
        "null"
       ]
      },
      "visible": {
       "type": "boolean"
      },
      "evidence": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "option",
      "visible",
      "evidence"
     ],
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "disagreements": {
   "type": "array",
   "description": "Written by tools/check_compare.py; the resolver fills resolution",
   "items": {
    "type": "object",
    "properties": {
     "parameter": {
      "type": "string",
      "pattern": "^[BS][0-9]{2}$"
     },
     "analyst_option": {
      "type": [
       "string",
       "null"
      ]
     },
     "checker_option": {
      "type": [
       "string",
       "null"
      ]
     },
     "resolution": {
      "type": [
       "string",
       "null"
      ],
      "description": "'changed' (analysis updated) or 'kept: <why, with evidence>'"
     }
    },
    "required": [
     "parameter",
     "analyst_option",
     "checker_option",
     "resolution"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "creative_id",
  "answers"
 ],
 "additionalProperties": false
}