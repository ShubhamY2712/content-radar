{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "report_content",
 "description": "What the report-document skill writes; tools/render_html.py turns it plus the run files into report.html and report_detailed.html.",
 "$defs": {
  "ids": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^C\\d+-\\d+$"
   }
  },
  "count": {
   "type": "object",
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "of": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "n",
    "of"
   ],
   "additionalProperties": false
  },
  "axis": {
   "type": "object",
   "properties": {
    "label": {
     "type": "string"
    },
    "low": {
     "type": "string"
    },
    "high": {
     "type": "string"
    }
   },
   "required": [
    "label",
    "low",
    "high"
   ],
   "additionalProperties": false
  },
  "vs_item": {
   "type": "object",
   "properties": {
    "parameter": {
     "type": "string",
     "pattern": "^[BS][0-9]{2}$"
    },
    "title": {
     "type": "string"
    },
    "meaning": {
     "type": "string"
    },
    "brand": {
     "$ref": "#/$defs/count"
    },
    "market": {
     "$ref": "#/$defs/count"
    },
    "creatives": {
     "$ref": "#/$defs/ids",
     "minItems": 1
    }
   },
   "required": [
    "parameter",
    "title",
    "meaning",
    "brand",
    "market",
    "creatives"
   ],
   "additionalProperties": false
  },
  "table_row": {
   "type": "object",
   "properties": {
    "parameter": {
     "type": "string",
     "pattern": "^[BS][0-9]{2}$"
    },
    "market": {
     "type": "string"
    },
    "brand": {
     "type": "string"
    },
    "gap": {
     "type": "string"
    },
    "status": {
     "enum": [
      "gap",
      "lead",
      "parity"
     ]
    },
    "evidence": {
     "$ref": "#/$defs/ids"
    },
    "swatches_market": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
     }
    },
    "swatches_brand": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
     }
    }
   },
   "required": [
    "parameter",
    "market",
    "brand",
    "gap",
    "status",
    "evidence"
   ],
   "additionalProperties": false
  },
  "table": {
   "type": "object",
   "properties": {
    "lede": {
     "type": "string"
    },
    "rows": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/table_row"
     }
    }
   },
   "required": [
    "lede",
    "rows"
   ],
   "additionalProperties": false
  }
 },
 "type": "object",
 "properties": {
  "version": {
   "const": 1
  },
  "dek": {
   "type": "string"
  },
  "logos": {
   "type": "object",
   "patternProperties": {
    "^C\\d+$": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "thumbnails": {
   "type": "object",
   "patternProperties": {
    "^C\\d+-\\d+$": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "key_frames": {
   "type": "object",
   "patternProperties": {
    "^C\\d+-\\d+$": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "maxItems": 6
    }
   },
   "additionalProperties": false
  },
  "why_selected": {
   "type": "object",
   "patternProperties": {
    "^C\\d+-\\d+$": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "brief": {
   "type": "object",
   "properties": {
    "paragraphs": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "maxItems": 3
    },
    "method_note": {
     "type": "string"
    }
   },
   "required": [
    "paragraphs",
    "method_note"
   ],
   "additionalProperties": false
  },
  "findings": {
   "type": "object",
   "properties": {
    "lede": {
     "type": "string"
    },
    "items": {
     "type": "array",
     "minItems": 3,
     "maxItems": 7,
     "items": {
      "type": "object",
      "properties": {
       "icon": {
        "type": "string"
       },
       "headline": {
        "type": "string"
       },
       "stat": {
        "type": "object",
        "properties": {
         "value": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
         },
         "of": {
          "type": "string"
         },
         "suffix": {
          "type": "string"
         },
         "label": {
          "type": "string"
         }
        },
        "required": [
         "value",
         "label"
        ],
        "additionalProperties": false
       },
       "key_line": {
        "type": "string"
       },
       "highlight": {
        "type": "string"
       },
       "detail": {
        "type": "string"
       },
       "creatives": {
        "$ref": "#/$defs/ids",
        "minItems": 1
       }
      },
      "required": [
       "icon",
       "headline",
       "stat",
       "key_line",
       "highlight",
       "detail",
       "creatives"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "lede",
    "items"
   ],
   "additionalProperties": false
  },
  "competitors": {
   "type": "object",
   "properties": {
    "lede": {
     "type": "string"
    },
    "selection_rule": {
     "type": "string"
    },
    "creative_rule": {
     "type": "string"
    },
    "why": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "baseline_why": {
     "type": "string"
    },
    "gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "lede",
    "selection_rule",
    "creative_rule",
    "why",
    "baseline_why",
    "gaps"
   ],
   "additionalProperties": false
  },
  "competitor_notes": {
   "type": "object",
   "properties": {
    "summary": {
     "type": "string"
    },
    "brands": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "strategy": {
        "type": "string"
       },
       "repeats": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "properties": {
          "text": {
           "type": "string"
          },
          "n": {
           "type": "integer",
           "minimum": 1
          },
          "of": {
           "type": "integer",
           "minimum": 1
          }
         },
         "required": [
          "text",
          "n",
          "of"
         ],
         "additionalProperties": false
        }
       },
       "standout": {
        "type": "object",
        "properties": {
         "creative": {
          "type": "string",
          "pattern": "^C\\d+-\\d+$"
         },
         "why": {
          "type": "string"
         }
        },
        "required": [
         "creative",
         "why"
        ],
        "additionalProperties": false
       },
       "does_not": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "name",
       "strategy",
       "repeats",
       "standout",
       "does_not"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "summary",
    "brands"
   ],
   "additionalProperties": false
  },
  "brand_vs_market": {
   "type": "object",
   "properties": {
    "lede": {
     "type": "string"
    },
    "gaps": {
     "type": "array",
     "minItems": 0,
     "items": {
      "$ref": "#/$defs/vs_item"
     }
    },
    "strengths": {
     "type": "array",
     "minItems": 0,
     "items": {
      "$ref": "#/$defs/vs_item"
     }
    }
   },
   "required": [
    "lede",
    "gaps",
    "strengths"
   ],
   "additionalProperties": false
  },
  "positioning_map": {
   "type": "object",
   "properties": {
    "x": {
     "$ref": "#/$defs/axis"
    },
    "y": {
     "$ref": "#/$defs/axis"
    },
    "reason": {
     "type": "string"
    },
    "points": {
     "type": "array",
     "minItems": 2,
     "items": {
      "type": "object",
      "properties": {
       "brand": {
        "type": "string"
       },
       "x": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "y": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      },
      "required": [
       "brand",
       "x",
       "y"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "x",
    "y",
    "reason",
    "points"
   ],
   "additionalProperties": false
  },
  "funnel_note": {
   "type": "string"
  },
  "business_table": {
   "$ref": "#/$defs/table"
  },
  "style_table": {
   "$ref": "#/$defs/table"
  },
  "ideas": {
   "type": "object",
   "properties": {
    "lede": {
     "type": "string"
    },
    "items": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {
       "type": {
        "enum": [
         "Proven pattern",
         "Fill a gap",
         "New funnel stage or format"
        ]
       },
       "title": {
        "type": "string"
       },
       "why": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "title",
       "why"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "lede",
    "items"
   ],
   "additionalProperties": false
  },
  "gallery_lede": {
   "type": "string"
  },
  "creatives_lede": {
   "type": "string"
  },
  "hooks": {
   "type": "object",
   "patternProperties": {
    "^C\\d+-\\d+$": {
     "type": "object",
     "properties": {
      "text": {
       "type": "string"
      },
      "translation": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "story": {
   "type": "object",
   "patternProperties": {
    "^C\\d+-\\d+$": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {
       "beat": {
        "type": "string",
        "pattern": "^SH[1-7] "
       },
       "from": {
        "type": "number",
        "minimum": 0
       },
       "to": {
        "type": "number",
        "minimum": 0
       },
       "what": {
        "type": "string"
       }
      },
      "required": [
       "beat",
       "from",
       "to",
       "what"
      ],
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
  }
 },
 "required": [
  "version",
  "dek",
  "logos",
  "thumbnails",
  "why_selected",
  "brief",
  "findings",
  "competitors",
  "competitor_notes",
  "brand_vs_market",
  "positioning_map",
  "business_table",
  "style_table",
  "ideas",
  "gallery_lede",
  "creatives_lede",
  "hooks",
  "story"
 ],
 "additionalProperties": false
}
